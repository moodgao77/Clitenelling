# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

# Safe to expose to the browser (protected by Row-Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Bypasses RLS. Used solely by the seed script
# and the Shopify sync job. Never import this into browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shopify sync (READ-ONLY). Used only by scripts/sync-shopify.mjs — never by
# the deployed app. Create a custom app in Shopify admin with read_customers
# and read_orders scopes, then paste its Admin API access token here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2024-10
