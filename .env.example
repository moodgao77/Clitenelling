# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

# Safe to expose to the browser (protected by Row-Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Bypasses RLS. Used solely by the seed script
# and the Shopify sync job. Never import this into browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shopify sync (READ-ONLY). Used only by scripts/sync-shopify.mjs — never by
# the deployed app. Create an app in the Shopify Dev Dashboard with
# read_customers + read_orders scopes; the script exchanges Client ID + Secret
# for a short-lived Admin API token (client-credentials grant).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_xxx
SHOPIFY_API_VERSION=2024-10
