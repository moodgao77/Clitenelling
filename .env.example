# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

# Safe to expose to the browser (protected by Row-Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Bypasses RLS. Used solely by the seed script
# and (later) the Shopify sync job. Never import this into browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
